  m_TableData:
  - m_Id: 8726446080
    m_Localized: "Med allting i sina h\xE4nder besegrade han AI."
    m_Metadata:
      m_Items: []
  - m_Id: 10672603136
    m_Localized: "All makt farfar har \xE4r bortom hans f\xF6rst\xE5nd."
    m_Metadata:
      m_Items: []
  - m_Id: 12446793728
    m_Localized: "Farfar h\xE5ller p\xE5 att bli galen."
    m_Metadata:
      m_Items: []
  - m_Id: 14661386240
    m_Localized: Farfar har tappat all kontroll.
    m_Metadata:
      m_Items: []
  - m_Id: 117912567808
    m_Localized: Vi alla hade fel om han.
    m_Metadata:
      m_Items: []
  - m_Id: 209885265920
    m_Localized: "Stoppa han. Stoppa farfar. Nu. Innan det \xE4r f\xF6r sent.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 244446330880
    m_Localized: "(ljudet b\xF6rjar glitcha mer o mer och fadea ut  ju mer mot slutet
      det kommer(kanske b\xF6rjar bli mer barnr\xF6st ju mer i slutet som kommer))"
    m_Metadata:
      m_Items: []
