  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Robot after recovery text_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 3ee12e76cc4e3624eb25c4703baf0da2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 32084340736
    m_Localized: "The memory\u2026 the factory\u2026 the voice that said I was whole.
      You\u2026 helped me remember.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 366118711296
    m_Localized: My code is still broken. But you, you fixed something important.
    m_Metadata:
      m_Items: []
  - m_Id: 512101462016
    m_Localized: 'Thank you for sticking around. Most people buy and leave. But you
      are different, you gave me something I lost a long time ago.

'
    m_Metadata:
      m_Items: []
  - m_Id: 776351002624
    m_Localized: I thought no one would care about me to the point of taking the
      time to help me. It warms my heart of steel.
    m_Metadata:
      m_Items: []
  - m_Id: 951463194624
    m_Localized: 'My family meant the world to me, it''s a pain to not have them
      here.

'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
